{{define "content"}}

<div class="card">
    {{ if .successful }}
    {{template "alert-success" .}}
    <p>
        <strong>{{ .i18n.T "recovery_key"}}</strong> <br>
    <div class="is-line"></div>
    <i class="recovery-key">{{.recovery_key}}</i>
    <div class="is-line"></div>
    </p>
    {{ else }}
    {{if .error}}
    {{template "alert-error" .}}
    {{else}}
    <form action="set-mfa" method="POST">
        {{ .csrfField }}
        <fieldset>
            <legend>{{ .i18n.T "title"}}</legend>
            {{ if .qr }}
            <div class="field">
                <figure class="m-0-a">
                    {{ .qr }}
                </figure>
            </div>
            {{end}}
            <input type="hidden" required name="secret" value="{{.secret}}">
            <div class="field">
                <button type="submit">{{ .i18n.T "fields.enable"}}</button>
            </div>
        </fieldset>
    </form>
    {{ end }}

    {{end}}
</div>
<div class="mt">
    <div class="text-align-center">
        <small>
            <a href="/account/">
                {{ .i18n.T "back_link"}}
            </a>
        </small>
    </div>
</div>
{{end}}